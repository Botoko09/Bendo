generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  whatsappNumber String
  products       Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String
  sold        Boolean   @default(false)
  soldAt      DateTime?
  orderClicks Int       @default(0)
  createdAt   DateTime  @default(now())
  sellerId    String
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([sold, createdAt])
}
